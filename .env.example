# =============================================================================
# Copy this file to ".env" and fill in your own free API key.
# NEVER commit the real .env file (it contains your secret key).
# =============================================================================

# Which LLM provider to use: "groq" or "openrouter"
LLM_PROVIDER=groq

# --- Groq (https://console.groq.com/keys) : free tier, NO credit card needed ---
GROQ_API_KEY=

# --- OpenRouter (https://openrouter.ai/keys) : free tier, NO credit card needed ---
OPENROUTER_API_KEY=

# --- Optional overrides (leave blank to use sensible defaults) ---
# Groq free default:
# LLM_MODEL=openai/gpt-oss-120b
# OpenRouter free default (vision-capable):
# LLM_MODEL=nvidia/nemotron-3.5-super-vl:free

# LLM_TEMPERATURE=0.2
# LLM_MAX_TOKENS=700
# LLM_TIMEOUT_SECONDS=30

# --- OCR (only needed for the image-upload endpoint) ---
# "rapidocr" (default, installs on Python 3.14) or "tesseract"
# OCR_ENGINE=rapidocr

# MAX_UPLOAD_MB=8
# TOP_SIMILAR_PRODUCTS=3
